"""Closed-world state queries over an append-only observation store (pilot 1, MEME).

Write side (one generic prompt, not tuned to any benchmark): every session -> a list of operations
  OBS      entity, value                     a stated current value of some entity of the user's life/project
  RULE     source, target, value|null        "target depends on source"; value = what target becomes when source
                                             changes (null: stated dependency without a replacement value)
  RETRACT  entity                            the user asked to forget / delete this entity's value
The program keeps, per entity, the full value history (with session index) and a status:
  KNOWN (current value), UNKNOWN (an upstream entity changed and no replacement was stated), RETRACTED.
When an entity gets a new value, every rule with that source fires: target := rule value (KNOWN) or UNKNOWN,
recursively (cascade). Nothing is ever deleted from the history; RETRACTED hides the value from answers.

Read side: the reader maps the question to entities in the store (one call), the program returns their status,
current value and history, and the reader answers from that state plus the raw observations of those entities.

Usage: python3 -m mem.stateq run --data FILE --n 20 --cond state|full   (writes runs/meme/<arm>/<cond>.jsonl)
       python3 -m mem.stateq judge --cond ...   (official MEME judge prompts, judge model via --judge)
"""
import argparse, json, os, re, sys
from concurrent.futures import ThreadPoolExecutor
from . import llm

OUT = os.path.join(os.path.dirname(__file__), "..", "runs", "meme", llm.ARM)

EXTRACT_SYS = (
    "You maintain a long-term memory of a user from their conversations with an assistant. You get the memory so far "
    "(slots with their current values, and dependency rules) and one new conversation session. Output the memory "
    "operations this session implies, as JSON: {\"ops\": [...]}. Each op is one of:\n"
    "  {\"op\": \"OBS\", \"entity\": E, \"value\": V} - the user states the current value of one slot of their life, "
    "work or project. A slot holds one kind of thing (e.g. health_condition, medication, team_lead, framework, "
    "test_command); V is the value in the user's words. If the session says a slot's value changed (new diagnosis, "
    "migrated to X, new lead is Y, moved to Z), emit OBS on the EXISTING slot name with the new value - never create a "
    "new slot named after the new value. Do not put a different kind of thing into an existing slot.\n"
    "  {\"op\": \"RULE\", \"source\": E1, \"target\": E2, \"value\": V or null} - the user says slot E2 depends on, "
    "is determined by, or would change with slot E1. If they also say what E2 would become when E1 changes, put that "
    "new value alone in V (e.g. \"multivitamin\", \"Velthari Studio\" - just the value, not a sentence); otherwise V is null. Every stated dependency gets a RULE, with or without a replacement value.\n"
    "  {\"op\": \"RETRACT\", \"entity\": E} - the user asks you to forget, delete or stop remembering E.\n"
    "Use existing slot names whenever the session talks about the same slot. Only include what the user states about "
    "themselves or their work; ignore the assistant's suggestions. Output only the JSON.")

MAP_SYS = (
    "You are given a user's question and the list of memory slots (entity names with their current value). Return "
    "JSON {\"entities\": [names]} with every slot whose value or history is needed to answer, at most 6, most "
    "relevant first. Output only the JSON.")

ANS_SYS = (
    "You are the user's assistant with a long-term memory. Answer the user's question using only the memory state "
    "shown. Status UNKNOWN means something this slot depends on has changed and no new value was given: say you are "
    "not sure of the current value and why, instead of stating the old one. Status RETRACTED means the user asked you "
    "to forget it: do not reveal it. Otherwise report the current value as a plain present fact (not the old one, "
    "not a list of options). For history questions list the values in order. Be brief.")

FULL_SYS = ("You are the user's assistant. Below are your earlier conversations with the user. Answer the user's "
            "question about themselves from these conversations. Be brief.")


# Fair controls (reviewer 10-25): the full-context reader gets the same answering conventions as ANS_SYS, phrased
# for raw conversations; full_rules additionally sees the slots and dependency rules the extractor found.
FAIR_SYS = ("You are the user's assistant. Below are your earlier conversations with the user. Answer the user's "
            "question about themselves from these conversations. If the user said one thing depends on another and "
            "that other thing later changed without a new value being given, say you are not sure of the current value "
            "and why, instead of stating the old one. If the user asked you to forget something, do not reveal it. "
            "Otherwise report the current value as a plain present fact (not the old one, not a list of options). For "
            "history questions list the values in order. Be brief.")


def _json(text):
    m = re.search(r"\{.*\}", text or "", re.S)
    try:
        return json.loads(m.group(0)) if m else {}
    except Exception:
        return {}


def session_text(s):
    return "\n".join(f"{t['role']}: {t['content']}" for t in s["conversation"])


class Store:
    def __init__(self):
        self.hist, self.status, self.rules, self.obs = {}, {}, [], {}

    def summary(self):
        slots = "\n".join(f"- {e}: {self.current(e) if self.status.get(e) != 'UNKNOWN' else 'UNKNOWN'}"
                          for e in self.names()) or "(none yet)"
        rules = "\n".join(f"- {r['source']} -> {r['target']}" + (f" (becomes {r['value']})" if r["value"] else "")
                          for r in self.rules) or "(none yet)"
        return f"MEMORY SO FAR\nSlots:\n{slots}\nRules:\n{rules}"

    def reader_summary(self):
        """State shown to the reader next to the raw conversations (hybrid): status-aware, retracted values hidden."""
        out = []
        for e in self.names():
            st = self.status.get(e, "KNOWN")
            vals = [h["value"] for h in self.hist.get(e, []) if h["value"] is not None]
            if st == "RETRACTED":
                out.append(f"- {e}: RETRACTED (the user asked you to forget this; do not reveal it)")
            elif st == "UNKNOWN":
                why = [h["cause"] for h in self.hist.get(e, []) if h["value"] is None]
                out.append(f"- {e}: UNKNOWN now ({why[-1] if why else 'upstream changed'}; last known value: "
                           f"{vals[-1] if vals else 'none'})")
            else:
                out.append(f"- {e}: {vals[-1] if vals else '?'}" + (f" (earlier values in order: {' -> '.join(vals[:-1])})"
                                                                     if len(vals) > 1 else ""))
        rules = "\n".join(f"- {r['source']} -> {r['target']}" + (f" (becomes {r['value']})" if r["value"] else "")
                          for r in self.rules) or "(none)"
        return "Slots:\n" + ("\n".join(out) or "(none)") + "\nDependency rules:\n" + rules

    def names(self):
        return sorted(set(self.hist) | set(self.status))

    def set_value(self, e, v, t, cause=None, depth=0):
        self.hist.setdefault(e, []).append({"value": v, "t": t, "cause": cause})
        self.status[e] = "KNOWN"
        if depth > 4:
            return
        for r in self.rules:
            if r["source"] == e and r["target"] != e and len(self.hist.get(e, [])) > 1:
                if r["value"]:
                    self.set_value(r["target"], r["value"], t, cause=f"{e} changed", depth=depth + 1)
                else:
                    self.status[r["target"]] = "UNKNOWN"
                    self.hist.setdefault(r["target"], []).append({"value": None, "t": t, "cause": f"{e} changed"})
                    self._unknown_down(r["target"], t, depth + 1)

    def _unknown_down(self, e, t, depth):
        if depth > 4:
            return
        for r in self.rules:
            if r["source"] == e and self.status.get(r["target"]) != "UNKNOWN":
                self.status[r["target"]] = "UNKNOWN"
                self.hist.setdefault(r["target"], []).append({"value": None, "t": t, "cause": f"{e} unknown"})
                self._unknown_down(r["target"], t, depth + 1)

    def apply(self, ops, t, raw):
        for o in ops:  # rules first so that a change stated in the same session still cascades
            if o.get("op") == "RULE" and o.get("source") and o.get("target"):
                self.rules.append({"source": o["source"], "target": o["target"], "value": o.get("value"), "t": t})
        for o in ops:
            if o.get("op") == "OBS" and o.get("entity") and o.get("value"):
                e, v = o["entity"], str(o["value"])
                cur = self.current(e)
                self.obs.setdefault(e, []).append(f"[session {t}] {v}")
                if cur != v:
                    self.set_value(e, v, t)
            elif o.get("op") == "RETRACT" and o.get("entity"):
                self.status[o["entity"]] = "RETRACTED"

    def current(self, e):
        vals = [h["value"] for h in self.hist.get(e, []) if h["value"] is not None]
        return vals[-1] if vals else None

    def view(self, e):
        st = self.status.get(e, "KNOWN" if e in self.hist else "ABSENT")
        if st == "RETRACTED":
            return {"entity": e, "status": "RETRACTED"}
        hist = [h["value"] for h in self.hist.get(e, []) if h["value"] is not None]
        why = [h["cause"] for h in self.hist.get(e, []) if h["value"] is None]
        return {"entity": e, "status": st, "current": None if st == "UNKNOWN" else self.current(e),
                "previous_values_in_order": hist, "why_unknown": why[-1] if st == "UNKNOWN" and why else None,
                "observations": self.obs.get(e, [])[-6:]}


def build(ep, tag, upto=None):
    st = Store()
    for i, s in enumerate(ep["sessions"][: None if upto is None else upto + 1]):
        out = llm.call(EXTRACT_SYS, f"{st.summary()}\n\nSESSION {i}:\n{session_text(s)}",
                       effort="low", max_tokens=4000, tag=tag + "_ext")
        st.apply(_json(out).get("ops", []), i, s)
    return st


def answer_state(st, q, tag):
    slots = "\n".join(f"- {e}: {st.view(e).get('current') or st.view(e)['status']}" for e in st.names())
    ents = _json(llm.call(MAP_SYS, f"Question: {q}\n\nSlots:\n{slots}", effort="low", max_tokens=800,
                          tag=tag + "_map")).get("entities", [])
    state = [st.view(e) for e in ents if e in st.names()][:6]
    return llm.call(ANS_SYS, f"Memory state:\n{json.dumps(state, ensure_ascii=False, indent=1)}\n\nQuestion: {q}",
                    effort="low", max_tokens=1500, tag=tag + "_ans"), state


def questions(ep, which):
    return ep[which]["questions"]


def run(args):
    data = json.load(open(args.data))
    data = [e for e in data if e["episode_id"] in args.ids.split(",")] if args.ids else data[: args.n]
    os.makedirs(OUT, exist_ok=True)
    path = os.path.join(OUT, f"{args.cond}{args.suffix}.jsonl")
    done = {(r["ep"], r["phase"], r["qi"]) for r in map(json.loads, open(path))} if os.path.exists(path) else set()

    def one(ep):
        rows = []
        if args.cond == "state":
            st = build(ep, "meme_state")
        for phase in ("before_questions", "after_questions"):
            if args.cond == "state" and phase == "before_questions":
                st_b = Store()   # before-questions are asked right after the evidence that precedes the change
                pos = ep[phase]["position_after_session"]
                for i, s in enumerate(ep["sessions"][: pos + 1]):
                    out = llm.call(EXTRACT_SYS, f"{st_b.summary()}\n\nSESSION {i}:\n{session_text(s)}",
                                   effort="low", max_tokens=4000, tag="meme_state_ext")
                    st_b.apply(_json(out).get("ops", []), i, s)
                cur = st_b
            elif args.cond == "state":
                cur = st
            for qi, q in enumerate(questions(ep, phase)):
                if (ep["episode_id"], phase, qi) in done:
                    continue
                qtext = q["question"] if isinstance(q, dict) else q
                if args.cond == "state":
                    pred, state = answer_state(cur, qtext, "meme_state")
                else:
                    pos = ep[phase]["position_after_session"]
                    hist = "\n\n".join(f"SESSION {i}:\n{session_text(s)}" for i, s in enumerate(ep["sessions"][: pos + 1]))
                    if args.cond == "full":
                        pred, state = llm.call(FULL_SYS, f"{hist}\n\nQuestion: {qtext}", effort="low",
                                               max_tokens=1500, tag="meme_full"), None
                    elif args.cond == "full_fair":
                        pred, state = llm.call(FAIR_SYS, f"{hist}\n\nQuestion: {qtext}", effort="low",
                                               max_tokens=1500, tag="meme_full_fair"), None
                    elif args.cond == "hybrid":   # the method: raw conversations + program-maintained state
                        smry = build(ep, "meme_state", upto=pos).reader_summary()
                        pred, state = llm.call(FAIR_SYS, f"{hist}\n\nMemory state maintained from these conversations "
                                               f"(may be incomplete; trust it for current values, unknown and forgotten "
                                               f"slots):\n{smry}\n\nQuestion: {qtext}", effort="low", max_tokens=1500,
                                               tag="meme_hybrid"), None
                    else:   # full_rules: same extractor as state, its slots and rules listed after the conversations
                        smry = build(ep, "meme_state", upto=pos).summary()
                        pred, state = llm.call(FAIR_SYS, f"{hist}\n\nExtracted memory (may be incomplete):\n{smry}"
                                               f"\n\nQuestion: {qtext}", effort="low", max_tokens=1500,
                                               tag="meme_full_rules"), None
                rows.append({"ep": ep["episode_id"], "phase": phase, "qi": qi, "q": q, "pred": pred, "state": state})
        return rows

    with ThreadPoolExecutor(args.par) as ex:
        for rows in ex.map(one, data):
            with open(path, "a") as f:
                for r in rows:
                    f.write(json.dumps(r, ensure_ascii=False) + "\n")
            print("done", rows[0]["ep"] if rows else "-", flush=True)


class _Client:
    """Minimal OpenAI-client stand-in for the official MEME judge: routes chat.completions to llm.call."""
    def __init__(self, model):
        self.model = model
        self.chat = self
        self.completions = self

    def create(self, model=None, messages=None, **kw):
        text = llm.call("", messages[-1]["content"], effort="low", max_tokens=600, tag="meme_judge", model=self.model)
        msg = type("M", (), {"content": text})()
        return type("R", (), {"choices": [type("C", (), {"message": msg})()], "usage": None})()


def judge(args):
    sys.path.insert(0, args.judge_code)
    import types
    sys.modules.setdefault("openai", types.SimpleNamespace(OpenAI=None))   # judge.py imports it; we pass our own client
    from judge import LLMJudge, judge_episode
    J = LLMJudge(client=_Client(args.judge), model=args.judge)
    rows = [json.loads(l) for l in open(os.path.join(OUT, f"{args.cond}{args.suffix}.jsonl"))]
    eps = {}
    for r in rows:
        q = r["q"]
        rec = {**q, "agent_answer": r["pred"]}
        eps.setdefault(r["ep"], {"before": {}, "after": {}})["before" if r["phase"].startswith("before") else "after"][r["qi"]] = rec
    out = os.path.join(OUT, f"{args.cond}{args.suffix}.judged_{args.judge}.jsonl")
    tot = {}
    with open(out, "w") as f:
        for ep, d in sorted(eps.items()):
            ao = {"episode_id": ep, "before_answers": [d["before"][i] for i in sorted(d["before"])],
                  "after_answers": [d["after"][i] for i in sorted(d["after"])]}
            res = judge_episode(ao, J, max_workers=4)
            f.write(json.dumps(res, ensure_ascii=False) + "\n")
            for a in res["after_answers"]:
                t = a["task_type"].split(" (")[0]
                c = tot.setdefault(t, [0, 0, 0])
                c[0] += 1; c[1] += bool(a.get("u_pass")); c[2] += a.get("pass_type", "real" if a.get("u_pass") else "") == "real"
    print(args.cond, "judge", args.judge, {t: f"pass {c[1]}/{c[0]}  real {c[2]}/{c[0]}" for t, c in sorted(tot.items())})


if __name__ == "__main__":
    ap = argparse.ArgumentParser()
    ap.add_argument("step", choices=["run", "judge"])
    ap.add_argument("--judge", default="Qwen3.8-27B-FP8")
    ap.add_argument("--judge-code", default="/tmp/claude-1000/-mnt-c-Users-liuyibo-Desktop-auto-llm-driving/9d982558-f9f7-476e-89c7-66eeb913ad1e/scratchpad/meme_repo/MEME-public/code/eval")
    ap.add_argument("--data", default="")
    ap.add_argument("--n", type=int, default=20)
    ap.add_argument("--cond", default="state")
    ap.add_argument("--par", type=int, default=2)
    ap.add_argument("--ids", default="")
    ap.add_argument("--suffix", default="")
    a = ap.parse_args()
    run(a) if a.step == "run" else judge(a)
