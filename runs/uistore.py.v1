"""Closed-world observation store for LongMemEval-V2 (web-agent trajectories), built by a program, no LLM.

Every state's accessibility tree is parsed into element observations
    (environment, page, container path, role, name)  -> where seen (trajectory, state), how often
where page = RootWebArea title + normalised URL path, and container path = the chain of named ancestors that are
dialogs, forms, menus, lists, tables, groups, ... For every (page, container) the store also keeps the complete set of
children observed in one state, so a query can check a claim against everything that was ever on screen there
("no checkbox label in the Personalize Form dialog contains 'Amortiz'") instead of against a top-k sample.
Steps (goal, thought, action, URL, outcome) are kept as a second relation for workflow questions.

Usage: python3 -m mem.uistore build --traj FILE --ids-from HAYSTACK.json --domain web --out DIR
"""
import argparse, collections, json, os, re
from urllib.parse import urlparse

LINE = re.compile(r"^(\t*)(?:\[(\d+)\] )?(\w+) ?(?:'((?:[^'\\]|\\.)*)'|\"((?:[^\"\\]|\\.)*)\")?(.*)$")
CONTAINERS = {"dialog", "alertdialog", "form", "menu", "menubar", "listbox", "list", "table", "grid", "tablist",
              "tabpanel", "group", "navigation", "region", "Section", "combobox", "tree", "rowgroup", "toolbar",
              "radiogroup", "banner", "contentinfo", "main", "complementary", "article", "heading", "row"}
SKIP = {"StaticText", "LineBreak", "generic", "none", "InlineTextBox", "paragraph"}


def norm_url(u):
    p = urlparse(u or "")
    path = re.sub(r"/\d+(?=/|$)", "/<n>", p.path)                 # record ids
    path = re.sub(r"/[0-9a-f]{16,}(?=/|$)", "/<id>", path)
    q = "&".join(sorted(k.split("=")[0] for k in p.query.split("&") if k)) if p.query else ""
    return path + ("?" + q if q else "")


def parse_tree(tree):
    """-> list of (depth, role, name, props) for named, non-text nodes; StaticText attached to the parent text."""
    out = []
    for raw in (tree or "").split("\n"):
        m = LINE.match(raw)
        if not m:
            continue
        depth, _, role, n1, n2, props = m.groups()
        name = (n1 if n1 is not None else n2 or "").replace("\\'", "'").strip()
        out.append((len(depth), role, name, props.strip(", ")))
    return out


class UIStore:
    def __init__(self):
        self.elem = {}          # key (env, page, cpath, role, name) -> {"n": count, "src": [(traj, state)] (first 5)}
        self.children = {}      # (env, page, cpath) -> {"n_seen": k, "items": set of "role 'name'"}
        self.pages = collections.Counter()
        self.steps = []         # dicts: traj, env, goal, outcome, i, url, page, action, thought

    def add_state(self, traj, s, env):
        nodes = parse_tree(s.get("accessibility_tree"))
        title = next((n for _, r, n, _ in nodes if r == "RootWebArea"), "")
        page = f"{title} [{norm_url(s.get('url'))}]"
        self.pages[(env, page)] += 1
        stack, seen_c = [], {}
        for depth, role, name, props in nodes:
            while stack and stack[-1][0] >= depth:
                stack.pop()
            cpath = " > ".join(f"{r} '{n}'" for _, r, n in stack if n) or "(page)"
            if role not in SKIP and role != "RootWebArea" and (name or role in CONTAINERS):
                if name:
                    k = (env, page, cpath, role, name)
                    e = self.elem.setdefault(k, {"n": 0, "src": []})
                    e["n"] += 1
                    if len(e["src"]) < 5:
                        e["src"].append((traj, s["state_index"]))
                    seen_c.setdefault(cpath, set()).add(f"{role} '{name}'" + (f" [{props}]" if "checked" in props
                                                                                   or "selected" in props else ""))
            if role in CONTAINERS or role == "RootWebArea":
                stack.append((depth, role, name if role != "RootWebArea" else ""))
            elif role == "StaticText" and stack and not stack[-1][2]:
                pass
        for cpath, items in seen_c.items():
            c = self.children.setdefault((env, page, cpath), {"n_seen": 0, "items": set()})
            c["n_seen"] += 1
            c["items"] |= items
        return page

    def add_traj(self, t):
        env = t.get("environment", "")
        for s in t["states"]:
            page = self.add_state(t["id"], s, env)
            self.steps.append({"traj": t["id"], "env": env, "goal": t.get("goal", ""), "outcome": t.get("outcome"),
                               "i": s["state_index"], "url": s.get("url"), "page": page,
                               "action": s.get("action"), "thought": (s.get("thought") or "")[:600]})

    def save(self, d):
        os.makedirs(d, exist_ok=True)
        with open(os.path.join(d, "elem.jsonl"), "w") as f:
            for k, v in self.elem.items():
                f.write(json.dumps({"env": k[0], "page": k[1], "cpath": k[2], "role": k[3], "name": k[4], **v},
                                   ensure_ascii=False) + "\n")
        with open(os.path.join(d, "children.jsonl"), "w") as f:
            for k, v in self.children.items():
                f.write(json.dumps({"env": k[0], "page": k[1], "cpath": k[2], "n_seen": v["n_seen"],
                                    "items": sorted(v["items"])}, ensure_ascii=False) + "\n")
        with open(os.path.join(d, "steps.jsonl"), "w") as f:
            for s in self.steps:
                f.write(json.dumps(s, ensure_ascii=False) + "\n")


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("step", choices=["build"])
    ap.add_argument("--traj"); ap.add_argument("--ids-from"); ap.add_argument("--domain"); ap.add_argument("--out")
    a = ap.parse_args()
    hs = json.load(open(a.ids_from))
    qdom = {json.loads(l)["id"]: json.loads(l)["domain"]
            for l in open(os.path.join(os.path.dirname(os.path.dirname(a.ids_from)), "questions.jsonl"))}
    need = set().union(*[set(v) for q, v in hs.items() if qdom[q] == a.domain])
    st = UIStore()
    for l in open(a.traj):
        t = json.loads(l)
        if t["id"] in need:
            st.add_traj(t)
    st.save(a.out)
    print(f"{a.domain}: {len(need)} trajectories, {len(st.steps)} states, {len(st.pages)} pages, "
          f"{len(st.children)} containers, {len(st.elem)} distinct element observations")


if __name__ == "__main__":
    main()


# ---------------------------------------------------------------- read side
STOP = set("""a an the of in on at to for from by with and or not no is are was were be been being do does did i we our
my me you your it its this that these those which what when where who whom how why there their them they as if then than
so such into onto about over under after before while during between within without can could should would will shall may
might must have has had one two three four five first second last next other another each every all any some more most
same only also just very please mark final answer short phrases phrase boxed single integer indicating amount working
portal page list view record option options field fields value values label labels button tab click open opening when
company typically usually use used using new name names format following question environment website site""".split())


def keywords(q):
    q = q.split("Mark your final answer")[0]
    quoted = re.findall(r"[`\"“']([^`\"”']{2,60})[`\"”']", q)
    caps = re.findall(r"\b(?:[A-Z][\w&-]*(?:\s+(?:[A-Z][\w&-]*|of|and|&))*)", q)
    words = [w for w in re.findall(r"[A-Za-z][\w-]{3,}", q) if w.lower() not in STOP]
    seen, out = set(), []
    for k in quoted + caps + words:
        k = k.strip()
        if k and k.lower() not in seen and k.lower() not in STOP:
            seen.add(k.lower()); out.append(k)
    return out


class UIIndex:
    """Loaded store + exhaustive lexical query with a coverage line."""
    def __init__(self, d):
        self.children = [json.loads(l) for l in open(os.path.join(d, "children.jsonl"))]
        self.steps = [json.loads(l) for l in open(os.path.join(d, "steps.jsonl"))]
        self.pages = sorted({c["page"] for c in self.children})

    def query(self, q, budget_chars=60000):
        kws = keywords(q)
        lk = [k.lower() for k in kws]
        weight = {k: (3.0 if " " in k or k[:1].isupper() else 1.0) for k in lk}
        scored = []
        for c in self.children:
            text = (c["page"] + " " + c["cpath"] + " " + " ".join(c["items"])).lower()
            s = sum(weight[k] * (1 + min(text.count(k), 5) / 5) for k in lk if k in text)
            if s:
                scored.append((s, c))
        scored.sort(key=lambda x: -x[0])
        hits = {k: sum(1 for _, c in scored if k in " ".join(c["items"]).lower()) for k in lk}
        absent = [k for k in kws if not hits[k.lower()] and not any(k.lower() in p.lower() for p in self.pages)]
        out, used, shown = [], 0, set()
        cov = (f"Memory covers {len(self.pages)} distinct pages and {len(self.children)} UI containers observed in "
               f"{len({s['traj'] for s in self.steps})} past trajectories; every container below is listed with ALL "
               f"elements ever observed in it.")
        if absent:
            cov += " Searched exhaustively: these terms never appear anywhere in the observed UI: " + \
                   ", ".join(repr(a) for a in absent[:12]) + "."
        out.append(cov)
        for s, c in scored:
            key = (c["page"], c["cpath"])
            if key in shown:
                continue
            block = f"\n## Page: {c['page']}\nContainer: {c['cpath']} (seen in {c['n_seen']} states)\n" + \
                    "\n".join("- " + i for i in c["items"][:120])
            if used + len(block) > budget_chars * 0.7:
                break
            out.append(block); used += len(block); shown.add(key)
        st = []
        for s in self.steps:
            text = (s["goal"] + " " + (s["thought"] or "") + " " + str(s["action"])).lower()
            sc = sum(weight[k] for k in lk if k in text)
            if sc:
                st.append((sc, s))
        st.sort(key=lambda x: -x[0])
        out.append("\n## Relevant past steps (goal | outcome | step: action | thought)")
        for sc, s in st:
            line = f"\n- [{s['goal'][:160]} | {s['outcome']}] step {s['i']} on {s['page'][:80]}: {s['action']} | {s['thought'][:300]}"
            if used + len(line) > budget_chars:
                break
            out.append(line); used += len(line)
        return "\n".join(out), kws
